{#
/**
 * @file
 * Theme override for a 'form' element.
 *
 * Available variables
 * - attributes: A list of HTML attributes for the wrapper element.
 * - children: The child elements of the form.
 *
 * @see template_preprocess_form()
 */
#}

{{ attach_library('atomic/chosen-select') }}

{%
  set classes = [
  'ys-filter-form',
  'ys-filter-form--scaffold',
]
%}

<form{{ attributes.addClass(classes) }}>
  {# Advise users up front that changing a filter updates results on its own, so the
     auto-submit is not an unexpected change of context (WCAG 2.1 SC 3.2.2). #}
  <p class="ys-filter-form__note">{{ 'Results update automatically as you make selections.'|t }}</p>
  {{ children }}
</form>
