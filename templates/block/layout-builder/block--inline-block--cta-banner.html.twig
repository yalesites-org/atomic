{% extends "@atomic/block/layout-builder/_layout-builder-block-template.twig" %}

{% block content %}
  {# Dial values are defaulted here (adapter layer) because older blocks can
     store NULL and the SDC schema enums are strict. #}
  {% embed 'atomic:cta-banner' with {
    banner__heading__level: content.field_heading_level.0['#markup']|default('2'),
    banner__link__content: content.field_link.0['#title'],
    banner__link__url: content.field_link.0['#url_title'],
    banner__link__content_two: content.field_link_two.0['#title'],
    banner__link__url_two: content.field_link_two.0['#url_title'],
    banner__content__background: content.field_style_color.0['#markup']|default('one'),
    banner__content__layout: content.field_style_position.0['#markup']|default('bottom'),
    banner__button__alignment: content.field_button_alignment.0['#markup'],
    banner__button__style__consistency: content.field_button_style_consistency.0['#markup'],
    banner__width: 'site',
    banner__overlay_background_image: content.field_overlay_background_image.0['#media'].field_media_image.entity.fileuri|file_url,
  } %}
    {% block heading %}{{ content.field_heading }}{% endblock %}
    {% block snippet %}{{ content.field_text }}{% endblock %}
    {% block image %}{{ content.field_media }}{% endblock %}
  {% endembed %}
{% endblock %}
