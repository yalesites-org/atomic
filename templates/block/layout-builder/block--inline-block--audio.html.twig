{% extends "@atomic/block/layout-builder/_layout-builder-block-template.twig" %}

{% block content %}

  {# Check the visible text, not the stored value: CKEditor saves an
   # "empty" box as <p>&nbsp;</p>, which renders blank but would still mark
   # the player as having a transcript and silence Editoria11y. #}
  {% set audio_embed__has_transcript = content.field_transcription['#items'].0.value|striptags|replace({'&nbsp;': ''})|trim is not empty %}

  {% if parentNode == 'post' or parentNode == 'event' %}
    {% set audio_embed__width = "content" %}
    {% set audio_embed__alignment = "center" %}
  {% else %}
    {% set audio_embed__width = "site" %}
    {% set audio_embed__alignment = "left" %}
  {% endif %}

  {% embed "@molecules/audio/yds-audio.twig" with {
    audio_embed__width: audio_embed__width,
    audio_embed__alignment: audio_embed__alignment,
    audio_embed__content: content.field_audio_label.0,
    audio_embed__transcript: audio_embed__has_transcript ? content.field_transcription,
  } %}
    {% block audio_embed__source %}
      {% if content.field_media.0['#media'].field_media_audio_file.entity.uri.value is not empty %}
        {{ content.field_media }}
      {% endif %}
    {% endblock %}
  {% endembed %}
{% endblock %}
