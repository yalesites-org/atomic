{% extends "@atomic/block/layout-builder/_layout-builder-block-template.twig" %}

{% block content %}
  {% embed 'atomic:custom-cards' with {
    custom_card_collection__heading: content.field_heading.0['#text'],
    custom_card_collection__width: 'site',
  } %}
    {% block cards %}
      {{ content.field_cards }}
    {% endblock %}
  {% endembed %}
{% endblock %}
