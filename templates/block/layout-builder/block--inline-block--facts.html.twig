{% extends "@atomic/block/layout-builder/_layout-builder-block-template.twig" %}

{% block content %}
  {# Dial values are defaulted here (adapter layer) because older blocks can
     store NULL and the SDC schema enums are strict. #}
  {% set facts__bg_image = content.field_media.0 ? 'true' : 'false' %}
  {% embed 'atomic:facts' with {
    facts_and_figures__group__heading: content.field_heading.0['#text'],
    facts_and_figures__group__content: content.field_text.0['#text'],
    facts_and_figures__group__alignment: content.field_style_alignment.0['#markup']|default('left'),
    facts_and_figures__group__grid_count: content.field_style_width.0['#markup']|default('four'),
    facts_and_figures__group__presentation_style: content.field_style_variation.0['#markup']|default('basic'),
    facts_and_figures__group__width: 'site',
    facts_and_figures__group__theme: content.field_style_color.0['#markup']|default('one'),
    facts_and_figures__group__bg_image: facts__bg_image,
  } %}
    {% block facts__items %}
      {{ content.field_facts_items }}
    {% endblock %}
    {% block facts__image %}
      {{ content.field_media }}
    {% endblock %}
  {% endembed %}
{% endblock %}
