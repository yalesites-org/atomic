{% extends "@atomic/block/layout-builder/_layout-builder-block-template.twig" %}

{% set image_banner__is_video = paragraph.field_media.entity.field_media_video_file.entity.uri.value is not empty %}
{% set image_banner__width = content.field_style_width.0['#markup']|default('site') %}

{% block content %}
  {# Dial values are defaulted here (adapter layer); the video flag is computed
     from the media type and passed as a prop (the SDC boundary can't carry the
     pre-SDC context flag). #}
  {% embed 'atomic:image-banner' with {
    image_banner__content__background: content.field_style_color.0['#markup']|default('one'),
    image_banner__overlay_variation: 'full',
    image_banner__size: content.field_style_variation.0['#markup']|default('tall'),
    image_banner__width: image_banner__width,
    image_banner__video: image_banner__is_video ? 'true' : 'false',
  } %}
    {% block video %}
      {% if image_banner__is_video %}
        {{ content.field_media }}
      {% endif %}
    {% endblock %}
    {% block image %}
      {% if not image_banner__is_video %}
        {% embed "@atoms/images/image/yds-image.twig" with {
          figure__caption: content.field_text.0,
        } %}
          {% block image__image %}
            {{ content.field_media }}
          {% endblock %}
        {% endembed %}
      {% endif %}
    {% endblock %}
  {% endembed %}
{% endblock %}
