{#
 # SDC thin wrapper for the Component Wrapper. The wrapped component markup is
 # injected into the CLT component_wrapper_inner block. directory is threaded for
 # nested atoms. Create-only — no consumer repointed yet.
 # See docs/sdc/recipe-convert-a-component-to-sdc.md.
 #}
{% set cw_inner %}{{ block('inner')|raw }}{% endset %}
{% embed '@organisms/component-wrapper/yds-component-wrapper.twig' with {
  component_wrapper__width: component_wrapper__width,
  component_wrapper__alignment: component_wrapper__alignment,
  component_wrapper__label: component_wrapper__label,
  component_wrapper__heading__level: component_wrapper__heading__level,
  directory: directory,
} only %}
  {% block component_wrapper_inner %}{{ cw_inner|raw }}{% endblock %}
{% endembed %}
{% if false %}{% block inner %}{% endblock %}{% endif %}
