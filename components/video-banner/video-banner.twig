{#
 # SDC thin wrapper for Video Banner. The video media is injected into the CLT
 # video_banner__video block. directory is threaded for nested atoms.
 # See docs/sdc/recipe-convert-a-component-to-sdc.md.
 #}
{% set vb_video %}{{ block('video')|raw }}{% endset %}
{% embed '@molecules/banner/video/yds-video-banner.twig' with {
  video_banner__width: video_banner__width,
  directory: directory,
} only %}
  {% block video_banner__video %}{{ vb_video|raw }}{% endblock %}
{% endembed %}
{% if false %}{% block video %}{% endblock %}{% endif %}
